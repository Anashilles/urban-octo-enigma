# Route Claude Code through OpenRouter's Anthropic-compatible endpoint.
#
# Copy to .env and fill in your key:   cp .env.example .env
# Load into the current shell:         source scripts/openrouter-env.sh
#
# .env is gitignored. Never commit a real key.

# Claude Code appends /v1/messages to this. Do not include a trailing slash
# and do not add /v1 yourself.
ANTHROPIC_BASE_URL=https://openrouter.ai/api

# Your OpenRouter key (starts with sk-or-v1-). Claude Code sends this as
# "Authorization: Bearer <token>", which is the header OpenRouter reads.
ANTHROPIC_AUTH_TOKEN=sk-or-v1-replace-me

# Must be present and EMPTY, not merely unset. ANTHROPIC_API_KEY is sent as
# the X-Api-Key header and takes precedence over your saved login; leaving a
# stale value here sends an Anthropic key to OpenRouter, which rejects it.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional. Uncomment only if you hit the matching symptom (see README).
# ---------------------------------------------------------------------------

# Map Claude Code's model aliases to OpenRouter model IDs (vendor/model form).
# Needed if requests fail with an unknown-model error. Look up exact, current
# IDs at https://openrouter.ai/models — do not guess them.
#ANTHROPIC_DEFAULT_OPUS_MODEL=anthropic/claude-opus-4.6
#ANTHROPIC_DEFAULT_SONNET_MODEL=anthropic/claude-sonnet-4.6
#ANTHROPIC_DEFAULT_HAIKU_MODEL=anthropic/claude-haiku-4.5

# Suppress pre-release request fields if OpenRouter returns 400 errors naming
# context_management or "Extra inputs are not permitted".
#CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1

# Stop Claude Code's non-model background traffic (version checks, telemetry).
# Also disables auto-update, so arrange another update path first.
#CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# MCP tool search is off by default on a non-first-party base URL. Turn it back
# on only if the gateway forwards tool_reference blocks.
#ENABLE_TOOL_SEARCH=true
