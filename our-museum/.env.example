# Our Museum — environment configuration.
# Copy to `.env` and fill in. Never commit real values. Every variable is
# described in docs/DEPLOYMENT.md. Empty values count as unset.
#
# Generate secrets with:  openssl rand -base64 48

# ---- App -----------------------------------------------------------------------
# Public URL of the web app (used for auth, links in emails, CORS/CSRF checks).
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Optional: shown in the footer and on the privacy page.
CONTACT_EMAIL=

# ---- Database (PostgreSQL 16+) -------------------------------------------------------
DATABASE_URL=postgresql://museum:museum@localhost:5432/our_museum
# Used only by docker-compose.yml for its bundled PostgreSQL.
POSTGRES_PASSWORD=
# Connection pool size per web process.
DATABASE_POOL_MAX=10

# ---- Authentication ------------------------------------------------------------
# Required, at least 32 characters.
BETTER_AUTH_SECRET=
# Require a verified email before signing in (needs working email delivery).
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Comma-separated emails allowed to open /admin.
ADMIN_EMAILS=
# Set to "off" only for automated test runs (disables auth rate limiting).
AUTH_RATE_LIMIT=

# ---- Email -----------------------------------------------------------------------
# console: emails are logged (development). smtp: sent through SMTP_URL.
EMAIL_DRIVER=console
EMAIL_FROM=Our Museum <no-reply@localhost>
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
# Tests only: keeps sent emails in memory for assertions. Refused when NODE_ENV=production.
ENABLE_DEV_OUTBOX=false

# ---- Photo storage -------------------------------------------------------------------
# local: files on disk (single server or a mounted volume). s3: any S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage
# Signs short-lived local-storage URLs. Defaults to a derivation of BETTER_AUTH_SECRET.
STORAGE_SIGNING_SECRET=
# S3 / R2 / MinIO (STORAGE_DRIVER=s3). The bucket must be private.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_BYTES=15728640

# ---- Realtime service (realtime/server.ts) ---------------------------------------------
# URL browsers connect to (wss:// in production). Read by the web app at runtime.
REALTIME_PUBLIC_URL=ws://localhost:4001
# URL the web app uses to notify the realtime service (server to server).
REALTIME_INTERNAL_URL=http://localhost:4001
# Shared by the web app and the realtime service. Defaults to a derivation of
# BETTER_AUTH_SECRET; set it explicitly when the services run separately.
REALTIME_TICKET_SECRET=
REALTIME_PORT=4001
# Comma-separated origins allowed to connect. Defaults to APP_URL's origin.
REALTIME_ALLOWED_ORIGINS=
# Trust X-Forwarded-For (only behind your own reverse proxy).
REALTIME_TRUST_PROXY=false
REALTIME_MAX_PER_ROOM=32
REALTIME_MAX_PER_USER=3

# ---- Voice chat (WebRTC) -----------------------------------------------------------------
# STUN works for most home networks; TURN is needed behind strict NATs/firewalls.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
# coturn `static-auth-secret` (use-auth-secret): short-lived credentials are minted per user.
TURN_SHARED_SECRET=

# ---- Maintenance ---------------------------------------------------------------------
# Bearer token for /api/cron/cleanup (Vercel Cron sends it automatically).
CRON_SECRET=

# ---- Development and tests only ------------------------------------------------------
# Exposes read-only scene state to Playwright. Baked in at build time: leave
# unset for production builds.
NEXT_PUBLIC_ENABLE_TEST_HOOKS=
# Demo account created by `npm run db:seed` (password printed once if unset).
SEED_EMAIL=
SEED_PASSWORD=
